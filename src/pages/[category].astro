---
// Esportivos e Antigos (docs/02): mesma estrutura, gerada por getStaticPaths.
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import RankingList from '@/components/ranking/RankingList.astro';
import Showcase from '@/components/showcase/Showcase.astro';
import { RANKING_SEO, getRanking } from '@/lib/rankings';
import { rankingOgImage, rankingStructuredData } from '@/lib/seo';

export const getStaticPaths = (() =>
  (['esportivos', 'antigos'] as const).map((category) => ({
    params: { category },
    props: { category },
  }))) satisfies GetStaticPaths;

interface Props {
  category: 'esportivos' | 'antigos';
}

const { category } = Astro.props;
const { title, description } = RANKING_SEO[category];
const vehicles = await getRanking(category);
---

<BaseLayout
  title={title}
  description={description}
  ogImage={rankingOgImage(vehicles)}
  structuredData={rankingStructuredData(category, vehicles)}
  activeNav={category}
>
  <Showcase vehicles={vehicles} rankingKey={category} />
  <RankingList vehicles={vehicles} rankingKey={category} />
</BaseLayout>

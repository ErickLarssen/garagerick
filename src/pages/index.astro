---
// Populares (home): vitrine + lista completa (temporária até a Fase 5).
import BaseLayout from '@/layouts/BaseLayout.astro';
import RankingPagePlaceholder from '@/components/ranking/RankingPagePlaceholder.astro';
import Showcase from '@/components/showcase/Showcase.astro';
import { RANKING_SEO, getRanking } from '@/lib/rankings';

const { title, description } = RANKING_SEO.populares;
const vehicles = await getRanking('populares');
---

<BaseLayout title={title} description={description} activeNav="populares">
  <Showcase vehicles={vehicles} rankingKey="populares" />
  <RankingPagePlaceholder vehicles={vehicles} ranking="populares" />
</BaseLayout>

---
// TEMPORÁRIO (Fase 2): conteúdo das páginas de ranking até a vitrine chegar na Fase 3.
// Chamar getRanking aqui mantém a validação do ranking ativa no build.
import { RANKING_LABELS, RANKING_SEO, getRanking, type RankingKey } from '@/lib/rankings';
import { formatRank } from '@/lib/format';

interface Props {
  ranking: RankingKey;
}

const { ranking } = Astro.props;
const vehicles = await getRanking(ranking);
---

<div class="px-[clamp(1.5rem,5vw,6rem)] pt-[calc(var(--header-h)+4rem)] pb-16">
  <h1 class="font-display text-display font-bold uppercase">{RANKING_LABELS[ranking]}</h1>
  <p class="mt-4 max-w-[60ch] text-text-muted">{RANKING_SEO[ranking].description}</p>
  <p class="mt-2 text-sm text-text-muted">
    {vehicles.length} veículos · a vitrine chega na Fase 3.
  </p>

  <ol reversed class="mt-8 grid max-w-xl gap-2">
    {vehicles.map((v) => (
      <li class="flex items-baseline gap-3">
        <span class:list={['numeric w-14', v.isTop ? 'text-gold' : 'text-accent']}>
          {v.isTop ? 'TOP 1' : formatRank(v.rank)}
        </span>
        <span>
          {v.brand.name} {v.name}
        </span>
      </li>
    ))}
  </ol>
</div>

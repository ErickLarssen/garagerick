---
// TEMPORÁRIO: lista simples abaixo da vitrine até o RankingList da Fase 5.
import { RANKING_LABELS, type RankedVehicle, type RankingKey } from '@/lib/rankings';
import { formatRank } from '@/lib/format';

interface Props {
  vehicles: RankedVehicle[];
  ranking: RankingKey;
}

const { vehicles, ranking } = Astro.props;
---

<section id="ranking" class="px-[clamp(1.5rem,5vw,6rem)] py-16">
  <h2 class="font-display text-4xl font-bold uppercase">
    Ranking completo — {RANKING_LABELS[ranking]}
  </h2>
  <ol reversed class="mt-8 grid max-w-xl gap-2">
    {vehicles.map((v) => (
      <li class="flex items-baseline gap-3">
        <span class:list={['numeric w-14', v.isTop ? 'text-gold' : 'text-accent']}>
          {v.isTop ? 'TOP 1' : formatRank(v.rank)}
        </span>
        <span>
          {v.brand.name} {v.name}
        </span>
      </li>
    ))}
  </ol>
</section>

---
// Card do carrossel (docs/05): <button> com imagem 3:4, logo pequeno e posição grande no canto.
import BrandLogo from '@/components/showcase/BrandLogo.astro';
import { formatRank } from '@/lib/format';
import { getCardImage } from '@/lib/images';
import type { RankedVehicle } from '@/lib/rankings';

interface Props {
  vehicle: RankedVehicle;
  index: number; // posição no array (0 = último colocado)
  active: boolean;
  /** Imagens longe da ponta inicial carregam sob demanda. */
  lazy: boolean;
}

const { vehicle, index, active, lazy } = Astro.props;
const card = await getCardImage(vehicle.cardImage);
const rankLabel = vehicle.isTop ? 'TOP 1' : formatRank(vehicle.rank);
---

<button
  type="button"
  class:list={['card', { 'card--top': vehicle.isTop }]}
  data-card
  data-index={index}
  data-slug={vehicle.slug}
  aria-label={`${vehicle.isTop ? 'Top 1' : formatRank(vehicle.rank)} — ${vehicle.brand.name} ${vehicle.name}`}
  aria-current={active ? 'true' : undefined}
>
  <img
    class="card__img"
    src={card.src}
    srcset={card.srcset}
    sizes={card.sizes}
    width={card.width}
    height={card.height}
    alt=""
    loading={lazy ? 'lazy' : 'eager'}
    decoding="async"
  />
  <span class="card__shade" aria-hidden="true"></span>
  <span class="card__rank" aria-hidden="true">
    {rankLabel}
  </span>
  <BrandLogo brand={vehicle.brand} baseHeight={18} class="card__logo" />
</button>

<style>
  .card {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-surface);
    cursor: pointer;
  }

  .card__img,
  .card__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .card__img {
    object-fit: cover;
  }

  .card__shade {
    background: linear-gradient(0deg, rgb(7 9 12 / 0.75) 0%, transparent 45%);
  }

  /* Número grande e translúcido no canto */
  .card__rank {
    position: absolute;
    top: 0.25rem;
    right: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 4vw, 3.25rem);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: rgb(255 255 255 / 0.35);
  }

  .card--top .card__rank {
    color: color-mix(in srgb, var(--color-gold) 80%, transparent);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
  }

  .card :global(.card__logo) {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    max-width: calc(100% - 1.5rem);
  }

  .card--top {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-gold) 60%, transparent);
  }
</style>

---
// Selo de posição (docs/04): accent com texto escuro e cantos chanfrados; Top 1 em dourado.
import { formatRank } from '@/lib/format';

interface Props {
  rank: number;
  class?: string;
}

const { rank, class: className } = Astro.props;
const isTop = rank === 1;
---

<span class:list={['rank-badge', { 'rank-badge--top': isTop }, className]} data-rank-badge>
  <span aria-hidden="true">{isTop ? 'TOP 1' : formatRank(rank)}</span>
  <span class="sr-only">{isTop ? 'Top 1' : `Posição ${rank}`}</span>
</span>

<style>
  .rank-badge {
    display: inline-block;
    padding: 0.1em 0.55em 0.05em;
    background: var(--color-accent);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
    clip-path: polygon(
      0.4em 0,
      100% 0,
      100% calc(100% - 0.4em),
      calc(100% - 0.4em) 100%,
      0 100%,
      0 0.4em
    );
  }

  /* Top 1: dourado com uma faixa de luz guardada fora do selo (background-position 100%);
     o controlador anima a posição para a luz atravessar o selo uma vez (docs/04) */
  .rank-badge--top {
    background-color: var(--color-gold);
    background-image: linear-gradient(
      105deg,
      transparent 40%,
      rgb(255 247 214 / 0.9) 50%,
      transparent 60%
    );
    background-size: 300% 100%;
    background-position: 100% 0;
    background-repeat: no-repeat;
  }
</style>

---
// Bloco de informações da vitrine (docs/05): BrandLogo → nome → SpecRow → texto → botões.
// A troca de veículo é anunciada pelo [data-showcase-announcer] da vitrine, não por este bloco
// (como região viva, ele relia logo, specs, texto e botões a cada troca, e o "Ler mais/menos").
import PlayIcon from '@/assets/icons/play.svg';
import SpecsIcon from '@/assets/icons/specs.svg';
import BrandLogo from '@/components/showcase/BrandLogo.astro';
import SpecRow from '@/components/showcase/SpecRow.astro';
import Button from '@/components/ui/Button.astro';
import type { RankedVehicle } from '@/lib/rankings';

interface Props {
  vehicle: RankedVehicle;
}

const { vehicle } = Astro.props;
---

<div class="info" data-showcase-info>
  <BrandLogo brand={vehicle.brand} decorative class="info__logo" />

  <h2 class="info__name" data-info-name tabindex="-1">
    <span class="sr-only">{vehicle.brand.name} </span>
    {vehicle.name}
  </h2>

  <SpecRow vehicle={vehicle} />

  <div class="info__body" id="showcase-body" data-info-body set:html={vehicle.body} />
  <button
    type="button"
    class="info__more"
    data-read-more
    aria-controls="showcase-body"
    aria-expanded="false"
    hidden
  >
    Ler mais
  </button>

  <div class="info__actions">
    <Button
      href={vehicle.videoUrl ?? ''}
      target="_blank"
      rel="noopener"
      variant="primary"
      data-info-video
      hidden={!vehicle.videoUrl}
    >
      <PlayIcon width={16} height={16} aria-hidden="true" />
      Vídeo
      <span class="sr-only">(abre o YouTube em nova aba)</span>
    </Button>
    <Button
      variant="secondary"
      data-open-specs
      command="show-modal"
      commandfor="spec-sheet"
      aria-haspopup="dialog"
    >
      <SpecsIcon width={18} height={18} aria-hidden="true" />
      Ficha técnica
    </Button>
  </div>
</div>

<style>
  .info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
    max-width: 40rem;
  }

  .info :global(.info__logo) {
    margin-bottom: 0.25rem;
  }

  /* recebe foco por script (vindo da lista); sem contorno, como um título */
  .info__name:focus {
    outline: none;
  }

  .info__name {
    font-family: var(--font-display);
    /* limita também pela altura da tela, para info + barra caberem na vitrine */
    font-size: min(var(--text-display), 10svh);
    line-height: var(--text-display--line-height);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .info__body {
    max-width: 60ch;
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    color: var(--color-text);
  }

  .info__body :global(p + p) {
    margin-top: 0.75em;
  }

  .info__more {
    min-height: 44px;
    margin-block: -0.75rem -0.5rem;
    font-size: var(--text-button);
    font-weight: var(--text-button--font-weight);
    letter-spacing: var(--text-button--letter-spacing);
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .info__more:hover {
    color: var(--color-text);
  }

  .info__more[hidden] {
    display: none;
  }

  @media (max-width: 639px) {
    .info {
      gap: 0.85rem;
    }

    .info__name {
      font-size: 2.5rem;
    }
  }

  /* Celular: texto em 4 linhas com "Ler mais" — só com JS (data-clamp); sem JS aparece inteiro */
  @media (max-width: 639px) {
    .info[data-clamp] .info__body:not(.is-expanded) {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 4;
      line-clamp: 4;
      overflow: hidden;
    }
  }

  .info__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>

<script>
  // "Ler mais" (docs/04): corta o texto em 4 linhas no celular e mostra o botão só se houver corte.
  // Exposto como evento para o controlador da Fase 4 reavaliar após trocar o texto.
  const info = document.querySelector<HTMLElement>('[data-showcase-info]');
  const body = info?.querySelector<HTMLElement>('[data-info-body]');
  const button = info?.querySelector<HTMLButtonElement>('[data-read-more]');

  if (info && body && button) {
    const mobile = window.matchMedia('(max-width: 639px)');

    const update = () => {
      body.classList.remove('is-expanded');
      button.setAttribute('aria-expanded', 'false');
      button.textContent = 'Ler mais';
      info.toggleAttribute('data-clamp', mobile.matches);
      button.hidden = !mobile.matches || body.scrollHeight <= body.clientHeight + 1;
    };

    button.addEventListener('click', () => {
      const expanded = body.classList.toggle('is-expanded');
      button.setAttribute('aria-expanded', String(expanded));
      button.textContent = expanded ? 'Ler menos' : 'Ler mais';
    });

    mobile.addEventListener('change', update);
    info.addEventListener('showcase:content-change', update);
    update();
  }
</script>

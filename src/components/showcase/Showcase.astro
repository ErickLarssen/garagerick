---
// Vitrine (docs/05): um veículo por tela — fundo, informações e a barra inferior
// (RANKING COMPLETO · ◀ #07 de 12 ▶ · redes). Sem cards (decisão de 2026-10-11).
// Tudo renderizado no servidor; o controlador só alterna o veículo.
import ArrowDownCircle from '@/assets/icons/arrow-down-circle.svg';
import SocialLinks from '@/components/layout/SocialLinks.astro';
import ShowcaseBackdrop from '@/components/showcase/ShowcaseBackdrop.astro';
import ShowcaseInfo from '@/components/showcase/ShowcaseInfo.astro';
import ShowcaseIntro from '@/components/showcase/ShowcaseIntro.astro';
import ShowcaseNav from '@/components/showcase/ShowcaseNav.astro';
import SpecSheet from '@/components/showcase/SpecSheet.astro';
import { RANKING_LABELS, type RankedVehicle, type RankingKey } from '@/lib/rankings';
import { buildShowcaseData, toScriptJson } from '@/lib/showcase-data';

interface Props {
  vehicles: RankedVehicle[]; // ordem decrescente (último colocado primeiro)
  rankingKey: RankingKey;
}

const { vehicles, rankingKey } = Astro.props;
const active = vehicles[0]; // primeiro slide depois da intro: o último colocado (docs/01)
const top = vehicles.at(-1) ?? active; // Top 1: teaser e tom ambiente da introdução
const label = RANKING_LABELS[rankingKey];
const data = toScriptJson(await buildShowcaseData(vehicles));
---

{active && top && (
  <section
    class="showcase is-intro"
    data-showcase
    aria-roledescription="vitrine"
    aria-label={`Ranking ${label}`}
    style={`--ambient: ${top.ambientColor}`}
  >
    <h1 class="sr-only">{label} — ranking de favoritos</h1>
    <!-- anúncio curto de cada troca feita pelo usuário (leitores de tela); preenchido pelo script -->
    <p class="sr-only" role="status" data-showcase-announcer></p>
    <ShowcaseBackdrop vehicle={active} teaser={top} />

    <div class="showcase__inner">
      <div class="showcase__main">
        <ShowcaseIntro rankingKey={rankingKey} total={vehicles.length} firstRank={active.rank} />
        <ShowcaseInfo vehicle={active} />
      </div>

      <div class="showcase__bar">
        <a href="#ranking" class="showcase__more">
          <ArrowDownCircle width={40} height={40} aria-hidden="true" />
          <span class="showcase__more-label">Ranking completo</span>
        </a>
        <ShowcaseNav vehicle={active} total={vehicles.length} intro />
        <SocialLinks class="showcase__social" />
      </div>
    </div>
    <SpecSheet vehicle={active} />
    <script type="application/json" id="showcase-data" data-showcase-data set:html={data} />
  </section>
)}

<!-- Link direto para um veículo (/esportivos#audi-tt): sai da intro antes da primeira pintura, sem
     esperar o módulo do controlador (que é adiado) — evita a intro piscar antes do veículo. -->
<script is:inline>
  (() => {
    const root = document.querySelector('[data-showcase]');
    const data = root?.querySelector('[data-showcase-data]')?.textContent;
    const slug = decodeURIComponent(location.hash.slice(1));
    if (!root || !data || !slug) return;
    if (JSON.parse(data).some((v) => v.slug === slug)) root.classList.remove('is-intro');
  })();
</script>

<script>
  import { initShowcase } from '@/scripts/showcase-controller';

  initShowcase();
</script>

<style>
  .showcase {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    overflow: hidden;
    transition: --ambient 400ms var(--ease-garage);
    touch-action: pan-y; /* swipe horizontal fica com o controlador; rolagem vertical segue normal */
  }

  .showcase__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: calc(var(--header-h) + 1.5rem) clamp(1.5rem, 5vw, 6rem) 1.25rem;
  }

  /* Introdução: o bloco do veículo some (a intro aparece no lugar — ShowcaseIntro) */
  .showcase.is-intro :global([data-showcase-info]) {
    display: none;
  }

  .showcase__main {
    flex: 1;
    display: flex;
    align-items: center;
    min-width: 0;
  }

  /* Barra inferior: RANKING COMPLETO · navegação · redes (como WATCH TRAILER na referência) */
  .showcase__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .showcase__more {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 44px;
    justify-self: start;
    font-size: var(--text-button);
    font-weight: var(--text-button--font-weight);
    letter-spacing: var(--text-button--letter-spacing);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--color-text);
  }

  /* Telas estreitas: só o ícone (o texto continua para leitores de tela), para a navegação caber */
  @media (max-width: 479px) {
    .showcase__more-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .showcase__more :global(svg) {
    color: var(--color-text-muted);
    transition:
      color 200ms var(--ease-garage),
      transform 300ms var(--ease-garage);
  }

  .showcase__more:hover :global(svg) {
    color: var(--color-accent);
    transform: translateY(2px);
  }

  .showcase :global(.showcase__social) {
    justify-self: end;
    margin-inline-end: -0.75rem;
  }

  /* Top 1 ativo (classe .is-top, ligada pelo controlador): contador em dourado */
  .showcase.is-top :global([data-counter-rank]) {
    color: var(--color-gold);
  }

  /* Celular (< 640px): imagem no topo, info sobre o degradê inferior */
  @media (max-width: 639px) {
    .showcase__inner {
      padding-top: 46svh; /* começa perto da base da foto (56svh) */
    }

    .showcase__main {
      align-items: flex-end;
    }

    .showcase__bar {
      grid-template-columns: 1fr auto;
    }

    /* Redes já estão no rodapé; aqui ficam o link e a navegação */
    .showcase :global(.showcase__social) {
      display: none;
    }

    .showcase__more {
      gap: 0.6rem;
    }
  }

  /* Tablet (640–1023px): mesma lógica do celular — foto no topo, info abaixo */
  @media (min-width: 640px) and (max-width: 1023px) {
    .showcase__inner {
      padding-top: 46svh;
    }

    .showcase__main {
      align-items: flex-end;
    }
  }

  /* Celular: textos longos empurravam a barra inferior (e as setas) para fora da tela. As setas
     saem da barra e ficam discretas nas bordas laterais, à meia altura da foto (entre o header e
     o começo das informações, em 46svh): sempre visíveis, indicando que dá para trocar, sem tapar
     o centro do carro. O contador #07 de 12 continua na barra. Tablet e desktop não mudam. */
  @media (max-width: 639px) {
    .showcase :global(.nav__arrow) {
      position: absolute;
      top: calc((var(--header-h) + 46svh) / 2 - 22px);
      z-index: 2;
      border-color: rgb(255 255 255 / 0.18);
      background: rgb(7 9 12 / 0.42);
      opacity: 0.85;
    }

    .showcase :global([data-showcase-prev]) {
      left: 0.375rem;
    }

    .showcase :global([data-showcase-next]) {
      right: 0.375rem;
    }

    /* na ponta do ranking a seta inativa quase some (continua focável, por aria-disabled) */
    .showcase :global(.nav__arrow[aria-disabled='true']) {
      opacity: 0.15;
    }
  }

  /* Desktop (≥ 1024px): info ocupa ~5/12 da largura, à esquerda; a foto fica à direita */
  @media (min-width: 1024px) {
    .showcase__main > :global(*) {
      max-width: min(40rem, 42vw);
    }
  }
</style>

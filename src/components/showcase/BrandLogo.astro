---
// Logo da marca (docs/04). Dimensões e tratamento vêm de getBrandLogo (lib/images.ts).
import { getBrandLogo } from '@/lib/images';
import type { RankedVehicle } from '@/lib/rankings';

interface Props {
  brand: RankedVehicle['brand'];
  /** Altura base em px (vitrine: 40; card: menor). */
  baseHeight?: number;
  class?: string;
}

const { brand, baseHeight = 40, class: className } = Astro.props;
const logo = await getBrandLogo(brand, baseHeight);
---

<img
  src={logo.src}
  alt={brand.name}
  width={logo.width}
  height={logo.height}
  style={`height: ${logo.height}px`}
  class:list={['brand-logo', { 'brand-logo--white': logo.white }, className]}
  data-brand-logo
  decoding="async"
/>

<style>
  .brand-logo {
    display: block;
    width: auto; /* altura fixa via style: o reset do Tailwind (height: auto) faria a imagem crescer */
  }

  /* deixa logos monocromáticos brancos, levemente creme */
  .brand-logo--white {
    filter: brightness(0) invert(0.96) sepia(0.08);
  }
</style>

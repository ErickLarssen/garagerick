---
// Busca (docs/05): campo sem caixa com sublinhado de 1px (docs/04) e dropdown de resultados.
// Combobox ARIA 1.2: o foco fica no campo e a opção marcada é indicada por aria-activedescendant.
// Fica oculta até o script rodar — sem JS ela não funcionaria.
// variant "bar": dropdown flutuante no header. "drawer": campo largo e resultados no fluxo da gaveta.
import SearchIcon from '@/assets/icons/search.svg';

interface Props {
  /** Prefixo dos ids (há uma instância no header e outra na gaveta mobile). */
  id: string;
  variant?: 'bar' | 'drawer';
  class?: string;
}

const { id, variant = 'bar', class: className } = Astro.props;
const inputId = `${id}-input`;
const listboxId = `${id}-listbox`;
---

<search class:list={['search', `search--${variant}`, className]} data-search hidden>
  <label for={inputId} class="search__field">
    <SearchIcon width={20} height={20} aria-hidden="true" class="search__icon" />
    <span class="sr-only">Buscar veículo</span>
    <input
      id={inputId}
      type="search"
      role="combobox"
      aria-expanded="false"
      aria-controls={listboxId}
      aria-autocomplete="list"
      aria-keyshortcuts="/"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="go"
      placeholder="Buscar"
      class="search__input"
      data-search-input
    />
  </label>
  <div class="search__panel" data-search-panel hidden>
    <ul id={listboxId} role="listbox" aria-label="Resultados da busca" data-search-listbox></ul>
    <p class="search__empty" data-search-empty hidden>
      Nada encontrado nessa garagem.
    </p>
  </div>
  <p role="status" class="sr-only" data-search-status></p>
</search>

<style>
  .search {
    position: relative;
    display: block;
  }

  .search[hidden] {
    display: none;
  }

  .search__field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    cursor: text;
    transition:
      border-color 200ms var(--ease-garage),
      color 200ms var(--ease-garage);
  }

  .search__field:hover,
  .search__field:focus-within {
    border-bottom-color: var(--color-text-muted);
    color: var(--color-text);
  }

  .search__icon {
    flex: none;
  }

  .search__input {
    width: clamp(6rem, 14vw, 12rem);
    min-width: 0;
    padding-block: 0.5rem;
    background: transparent;
    color: var(--color-text);
    font-size: var(--text-nav);
    outline: none; /* o sublinhado do campo faz o papel de indicador de foco */
  }

  .search__input::placeholder {
    color: var(--color-text-muted);
  }

  .search__input::-webkit-search-cancel-button {
    display: none;
  }

  /* Foco: sublinhado em --color-accent com 2px (borda + sombra) */
  .search__field:focus-within {
    border-bottom-color: var(--color-accent);
    box-shadow: 0 1px 0 var(--color-accent);
  }

  .search--drawer .search__input {
    width: 100%;
  }

  .search__panel {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.5rem);
    z-index: 10;
    width: min(22rem, calc(100vw - 2rem));
    max-height: min(26rem, 70vh);
    padding: 0.375rem;
    overflow-y: auto;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.5);
  }

  .search__panel[hidden],
  .search__empty[hidden] {
    display: none;
  }

  /* Gaveta: resultados no fluxo, logo abaixo do campo */
  .search--drawer .search__panel {
    position: static;
    width: auto;
    max-height: none;
    margin-top: 0.5rem;
    box-shadow: none;
  }

  .search__empty {
    padding: 0.75rem 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  /* Opções criadas pelo script (fora do escopo do componente) */
  .search__panel :global(.search-option) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    padding: 0.375rem;
    border-radius: 4px;
    cursor: pointer;
  }

  .search__panel :global(.search-option:hover),
  .search__panel :global(.search-option[aria-selected='true']) {
    background: rgb(255 255 255 / 0.06);
  }

  .search__panel :global(.search-option[aria-selected='true']) {
    box-shadow: inset 2px 0 0 var(--color-accent);
  }

  .search__panel :global(.search-option__thumb) {
    flex: none;
    width: 4rem;
    height: 3rem;
    object-fit: cover;
    border-radius: 2px;
    background: var(--color-bg);
  }

  .search__panel :global(.search-option__text) {
    display: grid;
    min-width: 0;
    line-height: 1.3;
  }

  .search__panel :global(.search-option__name) {
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search__panel :global(.search-option__meta) {
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Gaveta estreita: a linha de marca/ranking quebra em vez de cortar "#06 em Populares" */
  .search--drawer .search__panel :global(.search-option__meta) {
    white-space: normal;
  }
</style>

<script>
  import { initSearch } from '@/scripts/search';

  initSearch();
</script>
